{
  "name": "college-event-manager",
  "version": "1.0.0",
  "private": true,
  "description": "College event manager with an Express.js API and SQLite storage",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "ai": "python ai_recommender.py",
    "test": "node --test",
    "test:events": "node --test test_event_flows.test.js",
    "test:ai": "python -m unittest test_ai_recommender.py"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0"
  }
}
