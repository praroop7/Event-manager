# Copy this file to .env, then replace both values with private, random secrets.
ORGANIZER_PASSWORD=yourStrongPassword123
SESSION_SECRET=yourVeryLongRandomSecretHere
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
TRUST_PROXY=0
AI_HOST=127.0.0.1
AI_PORT=8000
# If python/python3 is not on PATH, put the full Python executable path here.
# Example on Windows: PYTHON_COMMAND=C:/Tools/Python/python.exe
# Example on macOS/Linux: PYTHON_COMMAND=/usr/bin/python3
# PYTHON_COMMAND=python
